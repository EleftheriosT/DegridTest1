"{\n  \"openapi\": \"3.0.0\",\n  \"info\": {\n    \"title\": \"Game REST API\",\n    \"version\": \"1.0.0\",\n    \"description\": \"API for a multiplayer turn-based challenge game.\"\n  },\n  \"paths\": {\n    \"/games/{gameId}/players/{playerid}\": {\n      \"get\": {\n        \"summary\": \"Player views other players' information\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          },\n          {\n            \"name\": \"playerid\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Player information retrieved\"\n          }\n        }\n      }\n    },\n    \"/games/{gameId}/players/{playerId}/cells/{cellId}\": {\n      \"put\": {\n        \"summary\": \"Player selects a cell\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          },\n          {\n            \"name\": \"playerId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          },\n          {\n            \"name\": \"cellId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Cell selected successfully\"\n          }\n        }\n      }\n    },\n    \"/games/{gameId}/grid/cells/{cellId}\": {\n      \"put\": {\n        \"summary\": \"Update cell in game grid\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          },\n          {\n            \"name\": \"cellId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/Cell\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Cell updated successfully\"\n          }\n        }\n      }\n    },\n    \"/queue/players\": {\n      \"post\": {\n        \"summary\": \"Player joins the queue\",\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"playerid\": {\n                    \"type\": \"integer\"\n                  }\n                },\n                \"required\": [\n                  \"playerid\"\n                ]\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Player added to queue\"\n          }\n        }\n      }\n    },\n    \"/games/{gameId}/players/{playerId}\": {\n      \"delete\": {\n        \"summary\": \"Remove inactive player\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          },\n          {\n            \"name\": \"playerId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          },\n          {\n            \"name\": \"isConnected\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"boolean\"\n            }\n          },\n          {\n            \"name\": \"inGame\",\n            \"in\": \"query\",\n            \"required\": false,\n            \"schema\": {\n              \"type\": \"boolean\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Player removed\"\n          }\n        }\n      }\n    },\n    \"/games/{gameId}/grid\": {\n      \"put\": {\n        \"summary\": \"Edit the game grid\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Grid updated\"\n          }\n        }\n      },\n      \"get\": {\n        \"summary\": \"Player retrieves the grid\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Grid retrieved\"\n          }\n        }\n      }\n    },\n    \"/games/{gameId}/turn-order\": {\n      \"post\": {\n        \"summary\": \"Set Turn Order\",\n        \"description\": \"Sets the turn order for a turn-based game.\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            },\n            \"description\": \"The unique ID of the game\"\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Turn order set successfully\"\n          },\n          \"400\": {\n            \"description\": \"Invalid game ID or game is not turn-based\"\n          }\n        }\n      },\n      \"put\": {\n        \"summary\": \"Set or update turn order\",\n        \"description\": \"Configures or updates the turn order for a turn-based game.\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            },\n            \"description\": \"The unique ID of the game\"\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"turnOrder\": {\n                    \"type\": \"array\",\n                    \"items\": {\n                      \"type\": \"integer\"\n                    },\n                    \"description\": \"Array of player IDs in the desired turn order\"\n                  }\n                },\n                \"required\": [\n                  \"turnOrder\"\n                ]\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Turn order updated successfully\"\n          },\n          \"400\": {\n            \"description\": \"Invalid input or game is not turn-based\"\n          }\n        }\n      }\n    },\n    \"/games/{gameId}/turn\": {\n      \"get\": {\n        \"summary\": \"Get current turn information\",\n        \"description\": \"Retrieves the current player's turn for the specified game.\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            },\n            \"description\": \"The unique ID of the game\"\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Current turn retrieved successfully\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"currentPlayerId\": {\n                      \"type\": \"integer\",\n                      \"description\": \"The ID of the player whose turn it is\"\n                    },\n                    \"turnNumber\": {\n                      \"type\": \"integer\",\n                      \"description\": \"Current turn number in the game\"\n                    }\n                  }\n                }\n              }\n            }\n          },\n          \"404\": {\n            \"description\": \"Game not found\"\n          }\n        }\n      }\n    },\n    \"/games/{gameId}/players/{playerId}/rematch-vote\": {\n      \"put\": {\n        \"summary\": \"Player votes for a rematch\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          },\n          {\n            \"name\": \"playerId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"rematchvote\": {\n                    \"type\": \"boolean\"\n                  }\n                },\n                \"required\": [\n                  \"rematchvote\"\n                ]\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Rematch vote recorded\"\n          },\n          \"400\": {\n            \"description\": \"Invalid input\"\n          },\n          \"404\": {\n            \"description\": \"Game or player not found\"\n          }\n        }\n      }\n    },\n    \"/games/{gameId}/profiles\": {\n      \"post\": {\n        \"summary\": \"Initialize a player profile in a game\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"playerId\": {\n                    \"type\": \"integer\"\n                  }\n                },\n                \"required\": [\n                  \"playerId\"\n                ]\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"201\": {\n            \"description\": \"Player profile initialized\"\n          },\n          \"400\": {\n            \"description\": \"Invalid input\"\n          },\n          \"404\": {\n            \"description\": \"Game not found\"\n          },\n          \"409\": {\n            \"description\": \"Profile already exists\"\n          }\n        }\n      }\n    },\n    \"/players/{playerId}/exit\": {\n      \"put\": {\n        \"summary\": \"Player requests to exit the game\",\n        \"description\": \"Flags the player as wanting to exit the game. The system may later process the actual removal.\",\n        \"parameters\": [\n          {\n            \"name\": \"playerId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            },\n            \"description\": \"The unique ID of the player\"\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"exit\": {\n                    \"type\": \"boolean\",\n                    \"description\": \"Set to true to indicate the player wants to exit\"\n                  }\n                },\n                \"required\": [\n                  \"exit\"\n                ]\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Player exit status updated\"\n          },\n          \"404\": {\n            \"description\": \"Player not found\"\n          }\n        }\n      }\n    },\n    \"/games/{gameId}/players/{playerId}/inputcoordinates\": {\n      \"get\": {\n        \"summary\": \"Player initiates cell trade via coordinates\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          },\n          {\n            \"name\": \"playerId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          },\n          {\n            \"name\": \"row\",\n            \"in\": \"query\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          },\n          {\n            \"name\": \"column\",\n            \"in\": \"query\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Trade logic evaluated or executed successfully\"\n          },\n          \"400\": {\n            \"description\": \"Missing or invalid coordinates\"\n          },\n          \"404\": {\n            \"description\": \"Player or cell not found\"\n          }\n        }\n      }\n    },\n    \"/games/{gameId}/challenges/{challengeId}\": {\n      \"get\": {\n        \"summary\": \"Retrieve a challenge for a game\",\n        \"description\": \"Allows the game to provide a challenge to a player in a specific game. This satisfies the requirement that the game must be able to give challenges.\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            },\n            \"description\": \"The unique ID of the game\"\n          },\n          {\n            \"name\": \"challengeId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            },\n            \"description\": \"The ID of the challenge to retrieve\"\n          },\n          {\n            \"name\": \"playerId\",\n            \"in\": \"query\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            },\n            \"description\": \"ID of the player receiving the challenge\"\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Challenge retrieved successfully\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/Challenge\"\n                }\n              }\n            }\n          },\n          \"404\": {\n            \"description\": \"Challenge or game not found\"\n          }\n        }\n      }\n    },\n    \"/games/{gameId}/players/{playerId}/popup\": {\n      \"post\": {\n        \"summary\": \"Send popup message\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          },\n          {\n            \"name\": \"playerId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Popup sent\"\n          }\n        }\n      }\n    },\n    \"/games/{gameId}/players/{playerId}/forfeit\": {\n      \"put\": {\n        \"summary\": \"Player forfeits the game\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          },\n          {\n            \"name\": \"playerId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": false,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"inGame\": {\n                    \"type\": \"boolean\"\n                  }\n                }\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Player forfeited\"\n          }\n        }\n      }\n    },\n    \"/games/{gameId}/grid/cells/{cellId}/colour\": {\n      \"put\": {\n        \"summary\": \"System sets the colour of a cell based on ownership\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          },\n          {\n            \"name\": \"cellId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"cellColour\": {\n                    \"type\": \"integer\"\n                  }\n                },\n                \"required\": [\n                  \"cellColour\"\n                ]\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Cell colour updated by system\"\n          },\n          \"400\": {\n            \"description\": \"Invalid input\"\n          },\n          \"404\": {\n            \"description\": \"Game or cell not found\"\n          }\n        }\n      }\n    },\n    \"/games/{gameId}/players/{playerId}/challenge-answer\": {\n      \"post\": {\n        \"summary\": \"Player completes a challenge\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          },\n          {\n            \"name\": \"playerId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"challengeId\": {\n                    \"type\": \"integer\"\n                  },\n                  \"answer\": {\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"challengeId\",\n                  \"answer\"\n                ]\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Challenge answer submitted\"\n          }\n        }\n      }\n    },\n    \"/games/{gameId}/players/{playerId}/profile\": {\n      \"put\": {\n        \"summary\": \"Edit player profile in a game\",\n        \"description\": \"Allows a player to update their in-game profile, including language, username, and avatar.\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            },\n            \"description\": \"The ID of the game\"\n          },\n          {\n            \"name\": \"playerId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            },\n            \"description\": \"The ID of the player\"\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"multipart/form-data\": {\n              \"schema\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"username\": {\n                    \"type\": \"string\",\n                    \"description\": \"New username for the player\"\n                  },\n                  \"language\": {\n                    \"type\": \"string\",\n                    \"description\": \"Preferred language of the player\"\n                  },\n                  \"avatar\": {\n                    \"type\": \"string\",\n                    \"format\": \"binary\",\n                    \"description\": \"Profile picture (image file)\"\n                  }\n                },\n                \"required\": [\n                  \"username\",\n                  \"language\"\n                ]\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Player profile updated successfully\"\n          },\n          \"404\": {\n            \"description\": \"Player or game not found\"\n          }\n        }\n      }\n    },\n    \"/games/{gameId}/grid/update\": {\n      \"put\": {\n        \"summary\": \"Update the grid after each round\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Grid updated for round\"\n          }\n        }\n      }\n    },\n    \"/games\": {\n      \"post\": {\n        \"summary\": \"System creates a new game\",\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"language\": {\n                    \"type\": \"string\"\n                  },\n                  \"maxPlayers\": {\n                    \"type\": \"integer\"\n                  },\n                  \"players\": {\n                    \"type\": \"array\",\n                    \"items\": {\n                      \"$ref\": \"#/components/schemas/Player\"\n                    }\n                  }\n                },\n                \"required\": [\n                  \"language\",\n                  \"maxPlayers\",\n                  \"players\"\n                ]\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"201\": {\n            \"description\": \"Game created\"\n          }\n        }\n      }\n    },\n    \"/games/{gameId}/players/{playerId}/validate-input\": {\n      \"post\": {\n        \"summary\": \"Validate player input\",\n        \"description\": \"Used by the system to check whether the input (e.g. coordinates) provided by the player is valid in the context of the current game state.\",\n        \"parameters\": [\n          {\n            \"name\": \"gameId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            },\n            \"description\": \"The ID of the game\"\n          },\n          {\n            \"name\": \"playerId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            },\n            \"description\": \"The ID of the player whose input is being validated\"\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"coordinates\": {\n                    \"type\": \"integer\",\n                    \"description\": \"The player's submitted coordinates or move input\"\n                  }\n                },\n                \"required\": [\n                  \"coordinates\"\n                ]\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Input validated\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"isValid\": {\n                      \"type\": \"boolean\",\n                      \"description\": \"Whether the input is valid\"\n                    },\n                    \"message\": {\n                      \"type\": \"string\",\n                      \"description\": \"Optional validation feedback\"\n                    }\n                  }\n                }\n              }\n            }\n          },\n          \"400\": {\n            \"description\": \"Invalid request body\"\n          },\n          \"404\": {\n            \"description\": \"Game or player not found\"\n          }\n        }\n      }\n    }\n  },\n  \"components\": {\n    \"schemas\": {\n      \"Player\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"playerid\": {\n            \"type\": \"integer\"\n          },\n          \"username\": {\n            \"type\": \"string\"\n          },\n          \"language\": {\n            \"type\": \"string\"\n          },\n          \"avatar\": {\n            \"type\": \"string\",\n            \"format\": \"binary\"\n          }\n        }\n      },\n      \"Cell\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"cellid\": {\n            \"type\": \"integer\"\n          },\n          \"owner\": {\n            \"type\": \"integer\"\n          },\n          \"cellColour\": {\n            \"type\": \"integer\"\n          }\n        }\n      },\n      \"Game\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"gameid\": {\n            \"type\": \"integer\"\n          },\n          \"maxPlayers\": {\n            \"type\": \"integer\"\n          },\n          \"language\": {\n            \"type\": \"string\"\n          },\n          \"players\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"$ref\": \"#/components/schemas/Player\"\n            }\n          }\n        }\n      },\n      \"Challenge\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"challengeid\": {\n            \"type\": \"integer\"\n          },\n          \"answer\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}"